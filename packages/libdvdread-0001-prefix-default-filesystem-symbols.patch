From 2337f9ff7e0f7da066d5c912d8767c432ab34a14 Mon Sep 17 00:00:00 2001
From: Sidney.Li <sidneyli@augmentum.com.cn>
Date: Tue, 30 Jun 2026 15:10:01 +0800
Subject: [PATCH] dvdread: prefix default filesystem symbols

---
 src/file/dir_posix.c  |  6 +++---
 src/file/dir_win32.c  |  6 +++---
 src/file/file_posix.c |  8 ++++----
 src/file/file_win32.c |  8 ++++----
 src/file/filesystem.c | 14 +++++++-------
 src/file/filesystem.h | 14 +++++++-------
 6 files changed, 28 insertions(+), 28 deletions(-)

diff --git a/src/file/dir_posix.c b/src/file/dir_posix.c
index dadac26..0ab8cff 100644
--- a/src/file/dir_posix.c
+++ b/src/file/dir_posix.c
@@ -35,7 +35,7 @@
 #include <dvdread/dvd_filesystem.h>
 #include "filesystem.h"
 
-void *dir_open_default(dvd_reader_filesystem_h *fs, const char* dirname)
+void *dvdread_dir_open_default(dvd_reader_filesystem_h *fs, const char* dirname)
 {
     if (!fs)
         return NULL;
@@ -43,7 +43,7 @@ void *dir_open_default(dvd_reader_filesystem_h *fs, const char* dirname)
     return opendir(dirname);
 }
 
-int dir_read_default(void *dir, dvd_dirent_t *entry)
+int dvdread_dir_read_default(void *dir, dvd_dirent_t *entry)
 {
     struct dirent *p_e;
 
@@ -72,7 +72,7 @@ int dir_read_default(void *dir, dvd_dirent_t *entry)
     return 0;
 }
 
-void dir_close_default(void *dir)
+void dvdread_dir_close_default(void *dir)
 {
     if (dir)
         closedir((DIR *)dir);
diff --git a/src/file/dir_win32.c b/src/file/dir_win32.c
index c2bc6b4..3f1093c 100644
--- a/src/file/dir_win32.c
+++ b/src/file/dir_win32.c
@@ -36,7 +36,7 @@ typedef struct {
 } win32_dir_t;
 
 
-void *dir_open_default(dvd_reader_filesystem_h *fs, const char* dirname)
+void *dvdread_dir_open_default(dvd_reader_filesystem_h *fs, const char* dirname)
 {
     if (!fs)
         return NULL;
@@ -72,7 +72,7 @@ void *dir_open_default(dvd_reader_filesystem_h *fs, const char* dirname)
         return NULL;
 }
 
-int dir_read_default(void *dir, dvd_dirent_t *entry)
+int dvdread_dir_read_default(void *dir, dvd_dirent_t *entry)
 {
     win32_dir_t *wdir = (win32_dir_t*)dir;
     if (wdir->went.name[0]) {
@@ -86,7 +86,7 @@ int dir_read_default(void *dir, dvd_dirent_t *entry)
     return 1;
 }
 
-void dir_close_default(void *dir)
+void dvdread_dir_close_default(void *dir)
 {
     if (dir) {
         win32_dir_t *wdir = (win32_dir_t*)dir;
diff --git a/src/file/file_posix.c b/src/file/file_posix.c
index b325f4b..0967b99 100644
--- a/src/file/file_posix.c
+++ b/src/file/file_posix.c
@@ -43,7 +43,7 @@
 #endif
 
 
-void *file_open_default(dvd_reader_filesystem_h *fs, const char* filename)
+void *dvdread_file_open_default(dvd_reader_filesystem_h *fs, const char* filename)
 {
     if (!fs)
         return NULL;
@@ -80,7 +80,7 @@ void *file_open_default(dvd_reader_filesystem_h *fs, const char* filename)
     return handle;
 }
 
-ssize_t file_read_default(void *file, char *buf, size_t size)
+ssize_t dvdread_file_read_default(void *file, char *buf, size_t size)
 {
     if (size == 0) {
         return 0;
@@ -89,12 +89,12 @@ ssize_t file_read_default(void *file, char *buf, size_t size)
     return read(*(int*)file, buf, size);
 }
 
-off64_t file_seek_default(void *file, off64_t offset, int whence)
+off64_t dvdread_file_seek_default(void *file, off64_t offset, int whence)
 {
     return lseek(*(int*)file, offset, whence);
 }
 
-int file_close_default(void *file)
+int dvdread_file_close_default(void *file)
 {
     if (file) {
         int ret = close(*(int*)file);
diff --git a/src/file/file_win32.c b/src/file/file_win32.c
index 11951c6..9ff5327 100644
--- a/src/file/file_win32.c
+++ b/src/file/file_win32.c
@@ -32,7 +32,7 @@
 #include "filesystem.h"
 
 
-void *file_open_default(dvd_reader_filesystem_h *fs, const char* filename)
+void *dvdread_file_open_default(dvd_reader_filesystem_h *fs, const char* filename)
 {
     if (!fs)
         return NULL;
@@ -62,7 +62,7 @@ void *file_open_default(dvd_reader_filesystem_h *fs, const char* filename)
     return handle;
 }
 
-ssize_t file_read_default(void *file, char *buf, size_t size)
+ssize_t dvdread_file_read_default(void *file, char *buf, size_t size)
 {
     if (size == 0) {
         return 0;
@@ -71,12 +71,12 @@ ssize_t file_read_default(void *file, char *buf, size_t size)
     return read(*(int*)file, buf, size);
 }
 
-off64_t file_seek_default(void *file, off64_t offset, int whence)
+off64_t dvdread_file_seek_default(void *file, off64_t offset, int whence)
 {
     return _lseeki64(*(int*)file, offset, whence);
 }
 
-int file_close_default(void *file)
+int dvdread_file_close_default(void *file)
 {
     if (file) {
         int ret = close(*(int*)file);
diff --git a/src/file/filesystem.c b/src/file/filesystem.c
index cf67bb8..66bbd40 100644
--- a/src/file/filesystem.c
+++ b/src/file/filesystem.c
@@ -31,12 +31,12 @@ dvd_reader_filesystem_h* InitInternalFilesystem(void) {
   }
   fs->close = default_filesystem_close;
   fs->stat = stat_default;
-  fs->dir_open = dir_open_default;
-  fs->dir_read = dir_read_default;
-  fs->dir_close = dir_close_default;
-  fs->file_open = file_open_default;
-  fs->file_read = file_read_default;
-  fs->file_seek = file_seek_default;
-  fs->file_close = file_close_default;
+  fs->dir_open = dvdread_dir_open_default;
+  fs->dir_read = dvdread_dir_read_default;
+  fs->dir_close = dvdread_dir_close_default;
+  fs->file_open = dvdread_file_open_default;
+  fs->file_read = dvdread_file_read_default;
+  fs->file_seek = dvdread_file_seek_default;
+  fs->file_close = dvdread_file_close_default;
   return fs;
 }
diff --git a/src/file/filesystem.h b/src/file/filesystem.h
index 1d5226d..0df9350 100644
--- a/src/file/filesystem.h
+++ b/src/file/filesystem.h
@@ -22,14 +22,14 @@
 #include "dvdread/dvd_filesystem.h"
 
 /* default filesystem operations, each platform provides its own */
-void   *file_open_default(dvd_reader_filesystem_h *fs, const char* filename);
-ssize_t file_read_default(void *file, char *buf, size_t size);
-off64_t file_seek_default(void *file, off64_t offset, int whence);
-int     file_close_default(void *file);
+void   *dvdread_file_open_default(dvd_reader_filesystem_h *fs, const char* filename);
+ssize_t dvdread_file_read_default(void *file, char *buf, size_t size);
+off64_t dvdread_file_seek_default(void *file, off64_t offset, int whence);
+int     dvdread_file_close_default(void *file);
 
-void   *dir_open_default(dvd_reader_filesystem_h *fs, const char* dirname);
-int     dir_read_default(void *dir, dvd_dirent_t *entry);
-void    dir_close_default(void *dir);
+void   *dvdread_dir_open_default(dvd_reader_filesystem_h *fs, const char* dirname);
+int     dvdread_dir_read_default(void *dir, dvd_dirent_t *entry);
+void    dvdread_dir_close_default(void *dir);
 
 int     stat_default(dvd_reader_filesystem_h *fs, const char *path, dvdstat_t* statbuf);
 
-- 
2.39.5 (Apple Git-154)
